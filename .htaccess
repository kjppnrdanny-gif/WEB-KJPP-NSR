# 0. Pastikan karakter UTF-8 diterapkan otomatis ke semua file
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .css .js .json .xml

RewriteEngine On

# 1. Redirect HTTP ke HTTPS otomatis
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Route endpoint /api/visitor-stats ke visitor-stats.php
RewriteRule ^api/visitor-stats/?$ visitor-stats.php [L,QSA]

# 3. Lindungi data json counter dari akses publik langsung
<Files "visitor-data.json">
    Require all denied
</Files>
