# 0. Pastikan karakter UTF-8 diterapkan otomatis ke semua file
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .css .js .json .xml

RewriteEngine On

# 1. Redirect HTTP ke HTTPS otomatis
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect legacy / demo trusted-by.html langsung ke beranda rekanan resmi
RewriteRule ^trusted-by\.html$ /#rekanan [R=301,L]

# 3. Route endpoint /api/visitor-stats ke visitor-stats.php
RewriteRule ^api/visitor-stats/?$ visitor-stats.php [L,QSA]

# 4. Route endpoint /api/auth-* ke auth-handler.php
RewriteRule ^api/auth-token/?$ auth-handler.php?action=token [L,QSA]
RewriteRule ^api/auth-login/?$ auth-handler.php?action=login [L,QSA]
RewriteRule ^api/auth-verify/?$ auth-handler.php?action=verify [L,QSA]
RewriteRule ^api/auth-logout/?$ auth-handler.php?action=logout [L,QSA]
RewriteRule ^api/auth/?$ auth-handler.php [L,QSA]

# 5. Route endpoint /api/nolap-data-proxy, /api/kwitansi-data-proxy, /api/surat-umum-data-proxy & /api/absensi-data-proxy
RewriteRule ^api/nolap-data-proxy/?$ nolap-data-handler.php [L,QSA]
RewriteRule ^api/kwitansi-data-proxy/?$ kwitansi-data-handler.php [L,QSA]
RewriteRule ^api/surat-umum-data-proxy/?$ surat-umum-data-handler.php [L,QSA]
RewriteRule ^api/absensi-data-proxy/?$ absensi-data-handler.php [L,QSA]
RewriteRule ^api/operasional-data-proxy/?$ operasional-data-handler.php [L,QSA]
RewriteRule ^api/status-terintegrasi-proxy/?$ status-terintegrasi-handler.php [L,QSA]

# 6. Route endpoint /api/pdp-* ke pdp-consent-handler.php
RewriteRule ^api/pdp-consent/?$ pdp-consent-handler.php?action=consent [L,QSA]
RewriteRule ^api/pdp-request/?$ pdp-consent-handler.php?action=request [L,QSA]
RewriteRule ^api/pdp-verify/?$ pdp-consent-handler.php?action=verify [L,QSA]

# 7. Lindungi data json counter, database, antrean email, dan PDP audit logs dari akses publik langsung
<FilesMatch "^(visitor-data|nolap-data|nolap_database|dual_gate_database|kwitansi_database|surat_umum_database|absensi_database|operasional_database|mail_queue|pdp-consent-logs|pdp-requests).*\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 7B. Lindungi seluruh file log dan file lock internal
<FilesMatch "\.(log|lock|bak|backup)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 8. Blokir akses HTTP langsung ke direktori data dan backup internal
RewriteRule ^data(/.*)?$ - [F,L]
