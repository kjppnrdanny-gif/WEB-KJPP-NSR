# KJPP NSR — .gitignore (Security & Confidentiality Filter)

# 1. Database Operasional & Data Transaksi Internal (Sensitif)
data/*.json
!data/.gitkeep
data/backups/
data/sessions/*.json
data/sessions/*.lock
!data/sessions/.gitkeep
data/lampiran_cuti/
data/*.lock
data/.*.lock
data/*.secret
data/.*_secret
data/.operasional_secret
visitor-data.json
data/mail_queue.json
data/absensi_database.json
data/surat_umum_database.json

# 2. File Sistem & OS
.DS_Store
Thumbs.db
desktop.ini

# 3. Dependencies
node_modules/

# 4. Berkas Temporary, Logs & Backup
*.log
*.tmp
*.bak
*.bak-*
*.bak.*
.tmp_*
backups/
backup_server_production/
*.zip
evidence_final/
evidence_ringkas/
bukti_final_kjpp_nsr/

# 5. Berkas Hasil Build & File Pengujian Sementara
dist/
dist-staging/
screenshots/
scratch/
preview-*.html
test-*.html
test-*.txt
staging-*
*-dev.html

# 6. Kredensial, Rahasia Lingkungan & Berkas Import (Sensitif)
.env
.env.*
*.secret
cpanel_accounts.csv
cpanel_*.csv
*.csv
