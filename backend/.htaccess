# Lindungi direktori backend dan cegah akses langsung ke file konfigurasi/data
<FilesMatch "\.(json|lock|bak|log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Izinkan eksekusi skrip PHP proxy
<FilesMatch "auth-nik-presensi\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>
